# --- Secrets ---
.env
.env.local
*.env
!.env.example
backend/.env
runpod/.env

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
*.sqlite3
*.db

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
frontend/stats.html

# --- Model weights / large binaries (never commit) ---
*.ckpt
*.pth
*.onnx
*.safetensors
runpod/models/
runpod/weights/
# AFTER's TorchScript checkpoints (200-400 MB each — past GitHub's 100MB/file cap)
# are fetched at Dockerfile-build time via runpod/download_models.py, never committed.
# Scoped narrowly to runpod/after_models/ so it doesn't collide with frontend TypeScript.
runpod/after_models/*.ts
# ...except the small DDSP worker weights that must ship in the image (< GitHub 100MB/file):
!runpod/ddsp_models/violin.pth
!runpod/ddsp_models/violin48.pth
!runpod/vendor/ddsp_pytorch/components/ptcrepe/ptcrepe/crepe-full.pth
!runpod/after_models/.gitkeep

# --- Audio scratch (local test artifacts) ---
scratch/
tmp/
*.wav
*.flac
*.mp3
!frontend/public/**/*.mp3
# AFTER's canonical timbre-reference clips ship with the worker (~500KB each × 4 = 2MB).
!runpod/after_refs/*.wav

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.venv_ddsp/
