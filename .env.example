# =============================================================================
# ReTone — environment configuration (copy to backend/.env and fill in values)
# =============================================================================
# All of these are SERVER-SIDE ONLY. Never expose them to the browser.
# The browser only ever receives short-lived presigned URLs from the backend.

# --- App ---
RETONE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# --- Mock mode ---
# When true, the backend fakes separation locally (no RunPod/R2 needed) so you
# can run the whole UI end-to-end before credentials are wired. Set to false
# once RunPod + R2 below are configured.
MOCK_MODE=true

# --- Cloudflare R2 (S3-compatible) ---
# Create an R2 API token in the Cloudflare dashboard (Account > R2 > Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=retone
# Derived endpoint; usually https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Presigned URL lifetime (seconds)
PRESIGN_TTL_SECONDS=3600

# --- RunPod Serverless ---
# API key from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=
# Endpoint id created after deploying the worker image (see runpod/README.md)
RUNPOD_ENDPOINT_ID=
# Base is https://api.runpod.ai/v2/<RUNPOD_ENDPOINT_ID>
RUNPOD_POLL_INTERVAL_SECONDS=3
RUNPOD_JOB_TIMEOUT_SECONDS=600

# --- Hugging Face (optional) ---
# Not required for the chosen public model repos; only set if you add a gated model.
HF_TOKEN=
